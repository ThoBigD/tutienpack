## Summon BOSS: Tâm Ma và tự động trang bị vũ khí mạnh nhất từ Storage
# CUSTOM X Y Z
$summon mannequin $(X) $(Y) $(Z) {profile:{id:$(player_profile)},CustomName:[$(player_name)],Health:$(player_hp),attributes:[{id:max_health,base:$(player_hp)f}],equipment:{mainhand:$(weapon_max),head:$(helmet_max),chest:$(chestplate_max),legs:$(leggings_max),feet:$(boots_max)},Tags:["TamMa_1"]}
# BASE X Y Z
# $summon mannequin ~ ~ ~ {profile:{id:$(player_profile)},CustomName:[$(player_name)],Health:$(player_hp),attributes:[{id:max_health,base:$(player_hp)f}],equipment:{mainhand:$(weapon_max),head:$(helmet_max),chest:$(chestplate_max),legs:$(leggings_max),feet:$(boots_max)},Tags:["TamMa_1"]}
